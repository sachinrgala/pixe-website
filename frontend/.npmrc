# 🔒 SECURITY: Complete Package Lock Configuration
# All updates and checks are DISABLED

# Use exact versions (no ^ or ~)
save-exact=true

# Strict engine enforcement
engine-strict=true

# === DISABLE ALL UPDATE CHECKS ===
update-notifier=false
audit=false
fund=false

# Disable npm from checking registry for newer versions
prefer-offline=true

# Disable progress bar and reduce network chatter
progress=false

# Use package-lock.json strictly
package-lock=true

# Prevent lifecycle scripts (security)
# ignore-scripts=true
