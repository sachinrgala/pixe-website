# Production Environment Configuration
# ==================================

# 1. DATABASE (Required)
# Connection string to your PostgreSQL database.
# For Free Tier, use external providers like Neon (neon.tech), Supabase, or Nile.
DATABASE_URL="postgres://user:password@host:port/dbname?sslmode=require"

# 2. APPLICATION SETTINGS
# Set to 'production' for Cloud Run optimizations (JSON logging, no fs fallback)
NODE_ENV=production

# 3. SECURITY (Recommended)
# Secret key for signing authentication cookies.
COOKIE_SECRET="generate-a-long-random-string-here-utf8-safe"

# 4. PUBLIC URLS
# The URL where your backend API resides (usually same domain in Next.js)
NEXT_PUBLIC_API_URL="https://your-cloud-run-url.run.app"
