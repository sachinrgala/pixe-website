# Environment Variables Template for Cloud Run
# Usage: gcloud run services update SERVICE --env-vars-file env.yaml

# Common Variables
NODE_ENV: production
COOKIE_SECRET: "replace-with-long-random-string"

# Database (Required for Frontend & Backend)
DATABASE_URL: "postgres://user:pass@host:5432/db?sslmode=disable"

# Service Inter-communication (Auto-filled by deploy script usually, but can be manual)
# AI_SERVICE_URL: "https://pixe-ai-xyz.a.run.app"
# BACKEND_API_URL: "https://pixe-backend-xyz.a.run.app/api/v1"
